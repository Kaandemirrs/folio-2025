// Kariyer görseli modalı (CareerBoard.js): tam ekran, koyu zemin, pinch/tekerlek/çift dokunuşla yakınlaştırma
.career-modal
    position absolute
    top 0
    left 0
    width 100%
    height 100%
    z-index 30
    background rgba(16, 12, 20, 0.94)
    overflow hidden
    touch-action none
    -webkit-user-select none
    user-select none

    &[hidden]
        display none

    .career-stage
        position absolute
        top 0
        left 0
        width 100%
        height 100%
        display flex
        align-items center
        justify-content center

    .career-image
        max-width 100%
        max-height 100%
        object-fit contain
        transform-origin 50% 50%
        will-change transform
        pointer-events none

    .career-close
        position absolute
        top calc(12px + env(safe-area-inset-top, 0px))
        right calc(12px + env(safe-area-inset-right, 0px))
        width 56px
        height 56px
        border-radius 28px
        background rgba(255, 255, 255, 0.16)
        color #fff
        font-size 26px
        line-height 56px
        text-align center
        touch-action manipulation

        &:hover
            background rgba(255, 255, 255, 0.3)

    .career-hint
        position absolute
        left 0
        right 0
        bottom calc(16px + env(safe-area-inset-bottom, 0px))
        text-align center
        font-family "Nunito", sans-serif
        font-weight 700
        font-size 14px
        color rgba(255, 255, 255, 0.6)
        pointer-events none
        display none

        html.is-mode-touch &
            display block
