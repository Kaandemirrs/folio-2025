// İlk ziyaret ipuçları: giriş ekranındaki el yazısı beyaz stil (Amatic SC), yarı saydam, ekranın alt ortasında
.hints
    position absolute
    left 0
    right 0
    bottom calc(28px + env(safe-area-inset-bottom, 0px))
    display flex
    justify-content center
    pointer-events none
    z-index 4

    html.is-mode-touch &
        bottom calc(150px + env(safe-area-inset-bottom, 0px))

    .hints-text
        width fit-content
        max-width calc(100% - 32px)
        padding 4px 18px 8px
        font-family "Amatic SC", sans-serif
        font-weight 700
        font-size 30px
        line-height 1.05
        letter-spacing 0.02em
        text-align center
        color #fff
        background rgba(24, 18, 30, 0.38)
        border-radius 14px
        text-shadow 0 2px 6px rgba(0, 0, 0, 0.55)
        opacity 0
        transform translateY(8px) rotate(-0.6deg)
        transition opacity 0.5s ease, transform 0.5s ease

    &.is-visible .hints-text
        opacity 0.78
        transform translateY(0) rotate(-0.6deg)

    @media (prefers-reduced-motion: reduce)
        .hints-text
            transition none

// Dokunmatikte harita düğmesini vurgular (ipucu c)
.map-trigger.is-hinted
    animation hints-pulse 1.4s ease-in-out infinite

@keyframes hints-pulse
    0%, 100%
        filter none
    50%
        filter brightness(1.7)

@media (prefers-reduced-motion: reduce)
    .map-trigger.is-hinted
        animation none
