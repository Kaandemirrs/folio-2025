.garage
    position absolute
    top 0
    left 0
    width 100%
    height 100%
    pointer-events none
    display none
    z-index 5
    color #ffffff
    font-family "Amatic SC", sans-serif
    font-weight 700
    -webkit-user-select none
    user-select none

    &.is-visible
        display block

        .card
            animation garage-in 0.6s 0.9s both cubic-bezier(0.2, 0.9, 0.3, 1.2)

    .card
        position absolute
        left 32px
        bottom 32px
        width calc(100vw - 64px)
        max-width 380px
        padding 18px 22px 16px
        box-sizing border-box
        background rgba(29, 23, 33, 0.86)
        border-radius 14px
        box-shadow 0 8px 30px rgba(0, 0, 0, 0.35)
        pointer-events auto

    .header
        display flex
        justify-content space-between
        font-size 28px
        opacity 0.7

    .name
        font-size 54px
        line-height 0.95
        margin-top 2px

    .current
        display none
        margin-top 6px
        font-size 24px
        color #ffb646

        &.is-visible
            display block

    .description
        margin-top 8px
        font-size 28px
        line-height 1.05
        opacity 0.9

    .stats
        margin-top 14px

    .stat
        display flex
        align-items center
        font-size 26px
        margin-top 4px

        .label
            width 110px
            flex none

        .bar
            flex 1
            height 10px
            border-radius 5px
            background rgba(255, 255, 255, 0.16)
            overflow hidden

        .fill
            width 100%
            height 100%
            background linear-gradient(90deg, #ffb646, #ff347e)
            transform-origin 0 50%
            transform scaleX(0)
            transition transform 0.5s cubic-bezier(0.2, 0.9, 0.3, 1)

    .actions
        display flex
        gap 8px
        margin-top 14px

    .action
        flex none
        min-width 44px
        height 44px
        padding 0 14px
        border 0
        border-radius 8px
        background rgba(255, 255, 255, 0.14)
        color #ffffff
        font inherit
        font-size 28px
        cursor pointer

        &:hover
            background rgba(255, 255, 255, 0.28)

        &.select
            flex 1
            background #ff347e

            &:hover
                background #ff5b96

    // "Sür" basıldı, araç yükleniyor / perde iniyor: düğmeler pasif
    &.is-busy
        .action
            opacity 0.45
            pointer-events none

    .hint
        margin-top 10px
        font-size 22px
        opacity 0.55

    // Dokunmatik cihaz / dar ekran: kart üstte, dokunmatik düğmeler altta
    @media (hover: none), (max-width 640px)
        .card
            left 50%
            top 16px
            bottom auto
            transform translateX(-50%)
            width calc(100vw - 32px)
            max-width 420px
            padding 12px 16px 12px

        &.is-visible .card
            animation garage-in-mobile 0.6s 0.9s both ease-out

        .name
            font-size 44px

        .description
            font-size 24px

        .stats
            margin-top 8px

        .actions
        .hint
            display none

@keyframes garage-in
    from
        opacity 0
        transform translateY(20px)
    to
        opacity 1
        transform translateY(0)

@keyframes garage-in-mobile
    from
        opacity 0
        transform translate(-50%, -20px)
    to
        opacity 1
        transform translate(-50%, 0)
