
*
    box-sizing border-box
    margin 0
    padding 0
    -webkit-tap-highlight-color transparent

button
input
    background none
    color inherit
    border none
    padding 0
    font inherit
    outline inherit

button
    cursor pointer

html
body
.game
.modals
.menu
    position fixed
    top 0
    left 0
    width 100%
    height 100%
    font-family "Nunito", sans-serif
    font-optical-sizing auto
    font-weight 400
    font-style normal
    -webkit-font-smoothing antialiased
    -moz-osx-font-smoothing grayscale
    overflow hidden

.experience
    touch-action none

    .input-filter-wandering &,
    .input-filter-intro &
        cursor grab

        &:active
            cursor grabbing

html
    background radial-gradient(farthest-side at 0 0, #251f2b, #1d1721)
    font-size 20px
    touch-action manipulation // Prevents double tap zoom

    @media only screen and (max-width 520px)
        font-size 18px

    @media only screen and (max-width 440px)
        font-size 16px;

ul
ol
    padding-left 25px

.title
    margin-bottom 0.25em
    font-size 2.5rem
    font-family "Amatic SC", sans-serif
    font-weight 700
    font-style normal

.text
    margin-bottom 0.75em
    font-size 1rem

    a
        color inherit
        text-decoration underline

.text-small
    font-size 0.8rem

.text-danger
    color #ff87a2
    
    .icon
        vertical-align sub

.text-faded
    opacity 0.8

.text-align-right
    text-align right

.text-align-center
    text-align center

.horizontal-group
    display flex
    align-items center
    justify-content center
    gap 10px

    @media only screen and (max-width 520px)
        flex-direction column

    > *
        // margin-right 10px

        // &:last-child
        //     margin-right 0
        
a.button
        display inline-block

.button
    vertical-align top
    padding 0 16px
    height 58px
    line-height 58px
    border-radius 8px
    white-space nowrap
    color inherit
    text-decoration none
    border 1px solid alpha(#ffffff, 0.8)
    color alpha(#ffffff, 0.8)
    cursor default

    @media only screen and (max-width 520px)
        padding 0 13px
        height 50px
        line-height 50px

    @media only screen and (max-width 440px)
        padding 0 10px
        height 45px
        line-height 45px

    &:not(.is-disabled)
        cursor pointer

    &.is-disabled
        border-style dashed

        &.has-tooltip
            cursor help

    &.is-success
        color #d5ff95

    &.is-danger
        color #ff6a7c

    html:not(.is-mode-touch) &:not(.is-disabled):hover
        border 1px solid alpha(#ffffff, 1)
        color alpha(#ffffff, 1)

    .icon
        position relative
        vertical-align middle

        &.icon-audio
            top -2px

        &.icon-restart
            top -2px

        &.icon-flag
            top -1px

        &.icon-controller
            top -1px
